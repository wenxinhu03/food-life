page {
  min-height: 100vh;
  background: #f3f7f8;
  color: #102a2f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.primary-button {
  height: 88rpx;
  border-radius: 999rpx;
  background: #12b89f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.secondary-button {
  height: 72rpx;
  border-radius: 999rpx;
  background: #eef8f6;
  color: #0d9f8b;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
