<view wx:if="{{summary}}" class="page-shell summary-page">
  <view class="summary-hero">
    <view class="summary-illustration">
      <view class="note-card"></view>
      <view class="summary-bowl"></view>
    </view>
    <text class="eyebrow">{{displayDate}}</text>
    <text class="title">今日饮食总结</text>
    <text class="subtitle">根据当天记录整理出的轻量建议</text>
  </view>

  <view class="score-card">
    <view><text class="metric">{{summary.recordCount}}</text><text class="metric-label">记录</text></view>
    <view><text class="metric">{{summary.averageRating}}</text><text class="metric-label">平均分</text></view>
    <view><text class="metric">{{summary.tags.length}}</text><text class="metric-label">标签</text></view>
  </view>

  <view class="content-card">
    <text class="section-title">总结</text>
    <text class="summary-text">{{summary.summary}}</text>
  </view>

  <view class="content-card">
    <text class="section-title">建议</text>
    <view wx:for="{{summary.suggestions}}" wx:key="*this" class="suggestion-item">
      <text class="dot"></text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="action-row">
    <view class="secondary-button" bindtap="regenerate">重新生成</view>
    <view class="primary-button" bindtap="save">{{isSaved ? '已保存' : '保存总结'}}</view>
  </view>
</view>
