.summary-hero {
  min-height: 280rpx;
  padding: 34rpx;
  border-radius: 36rpx;
  background: #fff4dc;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.summary-illustration {
  position: absolute;
  right: 38rpx;
  top: 28rpx;
  width: 168rpx;
  height: 136rpx;
}

.note-card {
  position: absolute;
  right: 0;
  top: 10rpx;
  width: 112rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.summary-bowl {
  position: absolute;
  left: 8rpx;
  bottom: 12rpx;
  width: 96rpx;
  height: 48rpx;
  border-radius: 0 0 50rpx 50rpx;
  background: #12b89f;
}

.eyebrow {
  display: block;
  color: #12b89f;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #7c8b8f;
  font-size: 26rpx;
}

.score-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #073b43;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.metric {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
}

.content-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.summary-text,
.suggestion-item {
  margin-top: 18rpx;
  color: #334e52;
  font-size: 26rpx;
  line-height: 1.6;
}

.summary-text {
  display: block;
}

.suggestion-item {
  display: flex;
  gap: 14rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #12b89f;
  flex: none;
}

.action-row {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
